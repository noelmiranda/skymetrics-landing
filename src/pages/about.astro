---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About — SkyMetrics"
  description="SkyMetrics is a B2B platform for automated thermographic inspection of utility-scale solar PV farms, built on Anthropic Vision AI, PostGIS, and Google Cloud."
>
  <!-- Nav bar -->
  <header class="border-b border-slate/10 bg-white sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #4A90C4 0%, #3a7ab0 100%);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-heading font-bold text-slate text-xl tracking-tight">SkyMetrics</span>
      </a>
      <a href="/" class="font-body text-sm text-slate/60 hover:text-slate transition-colors flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Back to home
      </a>
    </div>
  </header>

  <main class="bg-background min-h-screen py-16 lg:py-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="mb-12">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-5 border" style="background: rgba(140,189,185,0.1); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
          Company
        </div>
        <h1 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-4">About SkyMetrics</h1>
        <p class="font-body text-slate/55 text-lg leading-relaxed">
          Automated thermal analytics and AI anomaly detection for utility-scale solar PV inspection.
        </p>
      </div>

      <!-- Content -->
      <div class="bg-white rounded-2xl border border-slate/8 divide-y divide-slate/8">

        <!-- Mission -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">Our Mission</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed">
            Undetected thermal anomalies silently erode solar farm performance — reducing energy yield by up to 25% before a single technician sets foot on site. SkyMetrics was built to change that. We give solar asset owners and O&amp;M teams the tools to turn raw drone thermography into precise, IEC-compliant inspection reports in minutes, not days.
          </p>
        </div>

        <!-- What we do -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">What We Do</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed mb-4">
            SkyMetrics Core is an end-to-end cloud platform for automated thermographic inspection of photovoltaic solar farms. Upload radiometric drone imagery and receive:
          </p>
          <ul class="space-y-2">
            {[
              'AI-powered fault classification — broken diodes, dead cells, soiling, and string disconnections.',
              'Calibrated ΔT severity scoring aligned to IEC 62446-3 crystalline silicon thresholds.',
              'Sub-meter GPS anomaly maps with PostGIS spatial indexing and interactive Leaflet visualisation.',
              'Publication-grade PDF inspection reports with module-level temperature deltas and field coordinates.',
              'Real-time webhook alerts when critical hotspots (ΔT > 15°C) are detected.',
              'Full REST API with OpenAPI 3.0.3 documentation for integration with CMMS and asset management platforms.',
            ].map(item => (
              <li class="flex items-start gap-3 font-body text-sm text-slate/70">
                <span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style="background: #8CBDB9;"></span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <!-- Technology -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">Technology</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed mb-4">
            SkyMetrics Core v1.5.0 is built on a battle-tested, enterprise-grade stack validated with 423 automated test suites and zero TypeScript errors.
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            {[
              { name: 'Anthropic Vision AI', desc: 'Radiometric fault extraction and anomaly classification' },
              { name: 'PostGIS + Leaflet.js', desc: 'WGS-84 GPS indexing and interactive anomaly mapping' },
              { name: 'Google Cloud Storage & Tasks', desc: 'Signed URL ingestion and async batch processing' },
              { name: 'Node.js 24 + Fastify 5', desc: 'High-throughput REST API with OpenAPI 3.0.3' },
              { name: 'PostgreSQL 16 + PostGIS 3.4', desc: 'Spatial database with GiST indexed anomaly records' },
              { name: 'PDFKit', desc: 'Dynamic generation of publication-grade inspection reports' },
            ].map(item => (
              <div class="flex items-start gap-3 p-3.5 rounded-xl border border-slate/8 bg-background">
                <span class="w-2 h-2 rounded-full mt-1.5 shrink-0" style="background: #8CBDB9;"></span>
                <div>
                  <p class="font-heading font-semibold text-slate text-xs">{item.name}</p>
                  <p class="font-body text-slate/55 text-xs mt-0.5">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Who we serve -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">Who We Serve</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed mb-4">
            SkyMetrics is built for the professionals responsible for maintaining solar asset performance:
          </p>
          <ul class="space-y-2">
            {[
              ['Utility Solar Operators', 'Monitor and protect the Performance Ratio of large-scale PV plants.'],
              ['O&M Service Providers', 'Deliver IEC-compliant inspection reports to your clients faster and at lower cost.'],
              ['Drone Service Providers', 'Automate post-flight analysis and transform raw thermal footage into structured deliverables.'],
              ['Asset Managers', 'Benchmark thermal degradation across your portfolio and prioritise capital expenditure.'],
            ].map(([role, desc]) => (
              <li class="flex items-start gap-3 font-body text-sm">
                <span class="w-1.5 h-1.5 rounded-full mt-1.5 shrink-0" style="background: #E09E50;"></span>
                <span class="text-slate/70"><strong class="text-slate">{role}:</strong> {desc}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Company -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">Company</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed mb-3">
            SkyMetrics is headquartered in Gdańsk, Poland, operating as a GDPR-compliant B2B SaaS platform under Polish and EU law.
          </p>
          <div class="bg-background rounded-xl p-4 font-body text-sm text-slate/70 space-y-1">
            <p><strong class="text-slate">SkyMetrics</strong></p>
            <p>Gdańsk, Poland</p>
            <p>Email: <a href="mailto:contact@skymetrics.cloud" class="text-slate underline hover:text-solar transition-colors">contact@skymetrics.cloud</a></p>
          </div>
        </div>

        <!-- Contact -->
        <div class="px-8 py-7">
          <h2 class="font-heading font-bold text-slate text-lg mb-3">Get in Touch</h2>
          <p class="font-body text-slate/70 text-sm leading-relaxed mb-4">
            Ready to automate your thermographic inspections? Request a demo and we will respond within 2 business hours.
          </p>
          <a
            href="/#contact"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-body font-bold text-sm text-white transition-all shadow-md hover:shadow-lg active:scale-95"
            style="background: #E09E50;"
          >
            Request a Demo
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>

      </div>

      <p class="text-center font-body text-xs text-slate/40 mt-8">
        © {new Date().getFullYear()} SkyMetrics. All rights reserved.
      </p>
    </div>
  </main>
</BaseLayout>
