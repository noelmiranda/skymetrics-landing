---
export const prerender = false;
import AppLayout from '../../../components/layout/AppLayout.astro';
import InspectionList from '../../../components/app/InspectionList.svelte';
---

<AppLayout title="Inspections">
  <div class="flex items-center justify-between mb-6">
    <p class="text-slate/60 text-sm">All thermal inspections for your organization.</p>
    <a
      href="/app/inspections/new"
      class="bg-solar text-white text-sm font-semibold px-4 py-2 rounded-lg hover:bg-solar/90 transition-colors"
    >
      + New inspection
    </a>
  </div>

  <InspectionList client:load />
</AppLayout>
