---
const year = new Date().getFullYear();
---
<footer class="bg-slate py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-10 mb-12">

      <!-- Brand column -->
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #E09E50 0%, #c9813a 100%);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-heading font-bold text-white text-xl tracking-tight">SkyMetrics</span>
        </a>
        <p class="font-body text-white/45 text-sm leading-relaxed mb-6 max-w-xs">
          Drone thermographic inspection and AI for solar farms. Detect more. Produce more.
        </p>
        <div class="flex items-center gap-3">
          {[
            { label: 'LinkedIn', href: '#', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z' },
            { label: 'Twitter', href: '#', icon: 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z' },
            { label: 'YouTube', href: '#', icon: 'M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z M10 15l5.19-3L10 9v6z' },
          ].map(s => (
            <a href={s.href} aria-label={s.label} class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10 hover:border-mint/50 hover:bg-white/5 transition-all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Platform links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Platform</h4>
        <ul class="space-y-3">
          {['Thermographic inspection', 'Thermal orthomosaic', 'AI PDF reports', 'Automatic alerts', 'SCADA integration'].map(item => (
            <li>
              <a href="#features" class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Company</h4>
        <ul class="space-y-3">
          {['About us', 'Case studies', 'Blog', 'Careers', 'Press'].map(item => (
            <li>
              <a href="#" class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact column -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Contact</h4>
        <ul class="space-y-3">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke-linecap="round" stroke-linejoin="round"/><polyline points="22 6 12 13 2 6"/></svg>
            <a href="mailto:skymetric.cloud@gmail.com" class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">skymetric.cloud@gmail.com</a>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 mt-0.5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="10" r="3"/></svg>
            <span class="font-body text-white/45 text-sm">Madrid, Spain<br/>Operating across Europe</span>
          </li>
          <li class="mt-6">
            <a href="#contact" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-body font-semibold text-sm text-slate transition-all hover:shadow-lg active:scale-95" style="background: #E09E50;">
              Request Demo
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-body text-white/30 text-xs">
        © {year} SkyMetrics. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        {['Privacy policy', 'Terms of service', 'Cookies'].map(link => (
          <a href="#" class="font-body text-white/30 text-xs hover:text-white/60 transition-colors">{link}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
