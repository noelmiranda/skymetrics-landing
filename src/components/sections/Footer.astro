---
const year = new Date().getFullYear();
---
<footer class="bg-slate py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid grid-cols-2 lg:grid-cols-5 gap-8 lg:gap-10 mb-12">

      <!-- Brand column -->
      <div class="col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2.5 mb-5">
          <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background: linear-gradient(135deg, #4A90C4 0%, #3a7ab0 100%);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-heading font-bold text-white text-xl tracking-tight">SkyMetrics</span>
        </a>
        <p class="font-body text-white/45 text-sm leading-relaxed mb-6 max-w-xs">
          Automated thermal analytics and AI anomaly detection for utility-scale solar PV inspection. Turn raw drone thermography into actionable O&amp;M repair plans.
        </p>
        <div class="flex items-center gap-3">
          {[
            { label: 'LinkedIn', href: '#', icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 100-4 2 2 0 000 4z' },
            { label: 'Twitter', href: '#', icon: 'M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z' },
            { label: 'GitHub', href: '#', icon: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22' },
          ].map(s => (
            <a href={s.href} aria-label={s.label} class="w-9 h-9 rounded-lg flex items-center justify-center border border-white/10 hover:border-mint/50 hover:bg-white/5 transition-all">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.5)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d={s.icon}/>
              </svg>
            </a>
          ))}
        </div>
      </div>

      <!-- Product links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Product</h4>
        <ul class="space-y-3">
          {['Thermographic AI', 'Radiometric Mapping', 'IEC Anomaly Reports', 'CAD & GIS Exports'].map(item => (
            <li>
              <a href="#features" class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Solutions links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Solutions</h4>
        <ul class="space-y-3">
          {['Utility Solar Operators', 'O&M Service Providers', 'Drone Service Providers', 'Asset Managers'].map(item => (
            <li>
              <a href="#contact" class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Company</h4>
        <ul class="space-y-3">
          {[
            { label: 'About SkyMetrics', href: '#' },
            { label: 'Blog & Insights', href: '#' },
            { label: 'Documentation', href: '#' },
            { label: 'Contact', href: '#contact' },
          ].map(item => (
            <li>
              <a href={item.href} class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal links -->
      <div>
        <h4 class="font-heading font-semibold text-white text-sm mb-5">Legal</h4>
        <ul class="space-y-3">
          {[
            { label: 'Privacy Policy', href: '/privacy' },
            { label: 'Terms of Service', href: '/terms' },
            { label: 'Security & Compliance', href: '#' },
            { label: 'Cookie Settings', href: '/cookies' },
          ].map(item => (
            <li>
              <a href={item.href} class="font-body text-white/45 text-sm hover:text-white/80 transition-colors">{item.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-body text-white/30 text-xs">
        © {year} SkyMetrics. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        {[
          { label: 'Privacy policy', href: '/privacy' },
          { label: 'Terms of service', href: '/terms' },
          { label: 'Cookies', href: '/cookies' },
        ].map(link => (
          <a href={link.href} class="font-body text-white/30 text-xs hover:text-white/60 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
