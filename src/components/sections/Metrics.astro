---
const metrics = [
  {
    value: '+35%',
    label: 'Efficiency increase',
    desc: 'average gain in energy production after applying our maintenance recommendations',
    icon: 'chart',
    color: '#8CBDB9',
  },
  {
    value: '< 2h',
    label: 'Critical fault detection',
    desc: 'from drone take-off to hotspot notification delivered to your team',
    icon: 'speed',
    color: '#E09E50',
  },
  {
    value: '8x',
    label: 'First-year ROI',
    desc: 'return on investment by preventing production losses and module damage',
    icon: 'roi',
    color: '#8CBDB9',
  },
  {
    value: '99.4%',
    label: 'Detection accuracy',
    desc: 'validated anomaly identification across more than 50 solar farms worldwide',
    icon: 'accuracy',
    color: '#E09E50',
  },
];

const testimonials = [
  {
    quote: 'SkyMetrics let us detect 47 modules with hotspots that were silently degrading our output. The ROI was immediate.',
    name: 'Carlos Mendoza',
    role: 'Director of Operations',
    company: 'SolarTech Iberia',
    mw: '250MW',
  },
  {
    quote: 'The quality of the thermographic report and turnaround time exceeded all our expectations. We went from 3-week manual inspections to 24-hour reports.',
    name: 'Ana García',
    role: 'Asset Manager',
    company: 'Southern Renewables',
    mw: '180MW',
  },
];
---

<section id="benefits" class="py-24 lg:py-32" style="background: linear-gradient(180deg, #E8ECEB 0%, #dfe5e3 100%);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-4 border" style="background: rgba(140,189,185,0.12); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
        Proven results
      </div>
      <h2 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-5">
        Metrics that<br/>
        <span style="color: #8CBDB9;">speak for themselves</span>
      </h2>
      <p class="font-body text-slate/60 text-lg leading-relaxed">
        Real data from solar farms already using SkyMetrics to optimize their production.
      </p>
    </div>

    <!-- KPI cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      {metrics.map(m => (
        <div class="group bg-white rounded-2xl p-6 border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden" style="border-color: rgba(45,62,78,0.08);">
          <div class="absolute top-0 right-0 w-20 h-20 rounded-full -translate-y-10 translate-x-10" style={`background: ${m.color}; opacity: 0.08;`}></div>

          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background: ${m.color}18; border: 1px solid ${m.color}30;`}>
            {m.icon === 'chart' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
              </svg>
            )}
            {m.icon === 'speed' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linejoin="round"/>
              </svg>
            )}
            {m.icon === 'roi' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke-linecap="round"/>
              </svg>
            )}
            {m.icon === 'accuracy' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/><polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            )}
          </div>

          <p class="font-heading font-bold text-4xl mb-1 leading-none" style={`color: ${m.color};`}>{m.value}</p>
          <p class="font-heading font-semibold text-slate text-sm mb-2">{m.label}</p>
          <p class="font-body text-slate/50 text-xs leading-relaxed">{m.desc}</p>

          <div class="absolute bottom-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" style={`background: ${m.color};`}></div>
        </div>
      ))}
    </div>

    <!-- Testimonials -->
    <div class="grid md:grid-cols-2 gap-6">
      {testimonials.map(t => (
        <div class="bg-white rounded-2xl p-7 border border-slate/8 hover:shadow-lg transition-all duration-300">
          <div class="flex items-start gap-3 mb-5">
            <svg width="28" height="22" viewBox="0 0 28 22" fill="none">
              <path d="M0 22V13.2C0 9.6 0.933333 6.6 2.8 4.2C4.66667 1.8 7.33333 0.266667 10.8 0L12 2.8C10.2667 3.26667 8.86667 4.13333 7.8 5.4C6.73333 6.66667 6.13333 8.13333 6 9.8H11.2V22H0ZM16 22V13.2C16 9.6 16.9333 6.6 18.8 4.2C20.6667 1.8 23.3333 0.266667 26.8 0L28 2.8C26.2667 3.26667 24.8667 4.13333 23.8 5.4C22.7333 6.66667 22.1333 8.13333 22 9.8H27.2V22H16Z" fill="#8CBDB9" fill-opacity="0.4"/>
            </svg>
            <div class="flex">
              {[1,2,3,4,5].map(_ => (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="#E09E50"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
              ))}
            </div>
          </div>
          <p class="font-body text-slate/75 text-base leading-relaxed mb-6 italic">"{t.quote}"</p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-xl flex items-center justify-center font-heading font-bold text-sm text-white" style="background: linear-gradient(135deg, #2D3E4E, #4a6274);">
                {t.name.split(' ').map((n: string) => n[0]).join('')}
              </div>
              <div>
                <p class="font-body font-semibold text-slate text-sm">{t.name}</p>
                <p class="font-body text-slate/50 text-xs">{t.role} · {t.company}</p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-heading font-bold text-xl" style="color: #8CBDB9;">{t.mw}</p>
              <p class="font-body text-xs text-slate/40">installed</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
