---
const pillars = [
  {
    value: '423',
    label: 'Automated tests',
    desc: '398 backend (Jest) + 25 frontend (Vitest) — 0 failures, 0 TypeScript errors across the entire codebase',
    icon: 'tests',
    color: '#8CBDB9',
  },
  {
    value: '4',
    label: 'Fault types detected',
    desc: 'Broken diodes, dead cells, dirt accumulation, and disconnections — classified automatically by Claude Vision AI',
    icon: 'faults',
    color: '#E09E50',
  },
  {
    value: '100',
    label: 'Images per batch',
    desc: 'Upload up to 100 thermal images or a single ZIP archive per inspection run, with per-file failure isolation',
    icon: 'batch',
    color: '#8CBDB9',
  },
  {
    value: 'ΔT 15°C',
    label: 'Critical alert threshold',
    desc: 'Industry-standard temperature delta for crystalline silicon PV — any anomaly above this triggers an instant webhook alert',
    icon: 'temp',
    color: '#E09E50',
  },
];

const stack = [
  { name: 'Claude Vision', desc: 'Anthropic AI model for thermal image analysis', color: '#E09E50' },
  { name: 'PostGIS', desc: 'Geospatial indexing for GPS anomaly coordinates', color: '#8CBDB9' },
  { name: 'Google Cloud Tasks', desc: 'Async batch processing queue', color: '#2D3E4E' },
  { name: 'Svelte 5', desc: 'Admin dashboard with real-time polling', color: '#8CBDB9' },
  { name: 'Leaflet.js', desc: 'Interactive inspection location maps', color: '#E09E50' },
  { name: 'PDFKit', desc: 'Automatic inspection report generation', color: '#2D3E4E' },
];
---

<section id="benefits" class="py-24 lg:py-32" style="background: linear-gradient(180deg, #E8ECEB 0%, #dfe5e3 100%);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-4 border" style="background: rgba(140,189,185,0.12); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
        Platform by the numbers
      </div>
      <h2 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-5">
        Production-ready.<br/>
        <span style="color: #8CBDB9;">No guesswork.</span>
      </h2>
      <p class="font-body text-slate/60 text-lg leading-relaxed">
        SkyMetrics Core v1.5.0 ships with a complete test suite, a documented API, and real infrastructure — not a prototype.
      </p>
    </div>

    <!-- KPI cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-16">
      {pillars.map(m => (
        <div class="group bg-white rounded-2xl p-6 border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 relative overflow-hidden" style="border-color: rgba(45,62,78,0.08);">
          <div class="absolute top-0 right-0 w-20 h-20 rounded-full -translate-y-10 translate-x-10" style={`background: ${m.color}; opacity: 0.08;`}></div>

          <div class="w-10 h-10 rounded-xl flex items-center justify-center mb-4" style={`background: ${m.color}18; border: 1px solid ${m.color}30;`}>
            {m.icon === 'tests' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/><polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
            )}
            {m.icon === 'faults' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
              </svg>
            )}
            {m.icon === 'batch' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
              </svg>
            )}
            {m.icon === 'temp' && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={m.color} stroke-width="2">
                <path d="M14 14.76V3.5a2.5 2.5 0 00-5 0v11.26a4.5 4.5 0 105 0z"/>
              </svg>
            )}
          </div>

          <p class="font-heading font-bold text-3xl mb-1 leading-none" style={`color: ${m.color};`}>{m.value}</p>
          <p class="font-heading font-semibold text-slate text-sm mb-2">{m.label}</p>
          <p class="font-body text-slate/50 text-xs leading-relaxed">{m.desc}</p>

          <div class="absolute bottom-0 left-0 right-0 h-0.5 scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left" style={`background: ${m.color};`}></div>
        </div>
      ))}
    </div>

    <!-- Tech stack grid -->
    <div class="bg-white rounded-2xl border border-slate/8 overflow-hidden">
      <div class="px-6 py-5 border-b border-slate/8">
        <h3 class="font-heading font-bold text-slate text-lg">Technology Stack</h3>
        <p class="font-body text-slate/55 text-sm mt-1">Every component is production-grade and battle-tested</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-slate/8">
        {stack.map((s, i) => (
          <div class={`px-6 py-5 flex items-start gap-4 ${i >= 3 ? 'border-t border-slate/8' : ''}`}>
            <div class="w-9 h-9 rounded-lg flex items-center justify-center shrink-0 mt-0.5" style={`background: ${s.color}15; border: 1px solid ${s.color}25;`}>
              <div class="w-2.5 h-2.5 rounded-full" style={`background: ${s.color};`}></div>
            </div>
            <div>
              <p class="font-heading font-semibold text-slate text-sm">{s.name}</p>
              <p class="font-body text-slate/50 text-xs mt-0.5 leading-relaxed">{s.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
