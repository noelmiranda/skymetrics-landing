---
---
<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-slate/10 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <a href="/" class="flex items-center gap-2.5 group">
        <div class="w-9 h-9 rounded-xl flex items-center justify-center shadow-sm" style="background: linear-gradient(135deg, #E09E50 0%, #c9813a 100%);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <span class="font-heading font-bold text-slate text-xl tracking-tight">SkyMetrics</span>
      </a>

      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        <a href="#features" class="px-3 py-2 text-slate/65 hover:text-slate font-body text-sm font-medium transition-colors rounded-md hover:bg-slate/5">Features</a>
        <a href="#how-it-works" class="px-3 py-2 text-slate/65 hover:text-slate font-body text-sm font-medium transition-colors rounded-md hover:bg-slate/5">How It Works</a>
        <a href="#benefits" class="px-3 py-2 text-slate/65 hover:text-slate font-body text-sm font-medium transition-colors rounded-md hover:bg-slate/5">Benefits</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="#contact" class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 bg-solar text-white font-body font-semibold text-sm rounded-xl hover:bg-solar/90 transition-all shadow-sm hover:shadow-md active:scale-95">
          Request a Demo
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>

        <button id="mobile-menu-btn" class="md:hidden p-2 text-slate rounded-lg hover:bg-slate/5 transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate/10 bg-white" role="navigation" aria-label="Mobile navigation">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col gap-1">
      <a href="#features" class="px-3 py-2.5 text-slate/70 hover:text-slate font-body text-sm font-medium rounded-lg hover:bg-slate/5 transition-colors">Features</a>
      <a href="#how-it-works" class="px-3 py-2.5 text-slate/70 hover:text-slate font-body text-sm font-medium rounded-lg hover:bg-slate/5 transition-colors">How It Works</a>
      <a href="#benefits" class="px-3 py-2.5 text-slate/70 hover:text-slate font-body text-sm font-medium rounded-lg hover:bg-slate/5 transition-colors">Benefits</a>
      <div class="pt-2 border-t border-slate/10 mt-1">
        <a href="#contact" class="flex items-center justify-center gap-2 px-5 py-3 bg-solar text-white font-body font-semibold text-sm rounded-xl hover:bg-solar/90 transition-colors">
          Request a Demo
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden');
    btn.setAttribute('aria-expanded', String(!isOpen));
  });
  menu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
