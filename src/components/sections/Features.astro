---
const features = [
  {
    icon: 'ai',
    tag: 'Claude Vision AI',
    title: 'Automated Fault Detection',
    description: 'Every thermal image is analyzed by Claude Vision (Anthropic). The model classifies four fault types — broken diodes, dead cells, dirt, and disconnections — with severity levels from low to critical. No manual review needed.',
    stats: [
      { value: '4', label: 'Fault types' },
      { value: '3', label: 'Severity levels' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'map',
    tag: 'PostGIS + Leaflet',
    title: 'GPS-Georeferenced Anomaly Map',
    description: 'Each detected fault is persisted with exact GPS coordinates in a PostGIS-enabled PostgreSQL database. The interactive Leaflet.js map lets field technicians locate any anomaly instantly using bounding-box spatial queries.',
    stats: [
      { value: 'WGS-84', label: 'Coordinate system' },
      { value: 'GiST', label: 'Spatial index' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'report',
    tag: 'PDF Reports',
    title: 'Instant Inspection Reports',
    description: 'Every completed inspection generates a downloadable PDF report via PDFKit — anomaly summary, panel-level detail, temperature deltas, severity classifications, and GPS coordinates for every fault found.',
    stats: [
      { value: 'PDF', label: 'Instant download' },
      { value: 'ΔT 15°C', label: 'Critical threshold' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
  {
    icon: 'batch',
    tag: 'Batch Upload',
    title: 'Upload 100 Images or a ZIP',
    description: 'Drone operators upload up to 100 thermal images at once — or drop a single ZIP from their FLIR software. Files go directly to Google Cloud Storage via signed URLs. One failed image never aborts the rest of the batch.',
    stats: [
      { value: '100', label: 'Images per batch' },
      { value: 'ZIP', label: 'Archive support' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'alert',
    tag: 'Real-Time Alerts',
    title: 'Critical Fault Notifications',
    description: 'When an anomaly is classified as critical or exceeds the 15°C temperature delta threshold (industry standard for crystalline silicon PV), the alert system fires immediately — console log plus webhook POST to any configured endpoint.',
    stats: [
      { value: 'Webhook', label: 'Alert delivery' },
      { value: 'Instant', label: 'On detection' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'api',
    tag: 'REST API',
    title: 'Fully Documented API',
    description: 'Complete REST API with OpenAPI 3.0.3 documentation (Swagger UI at /docs). Integrate SkyMetrics into your existing SCADA, CMMS, or monitoring platform. Async batch analysis returns 202 Accepted immediately.',
    stats: [
      { value: 'OpenAPI', label: '3.0.3 spec' },
      { value: '202', label: 'Async response' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
];
---

<section id="features" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-4 border" style="background: rgba(140,189,185,0.1); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
        Platform Features
      </div>
      <h2 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-5">
        Everything built.<br/>
        <span style="color: #8CBDB9;">Everything working.</span>
      </h2>
      <p class="font-body text-slate/60 text-lg leading-relaxed">
        SkyMetrics Core is a production-ready B2B platform — 423 automated tests, 0 TypeScript errors — combining Claude Vision AI, PostGIS geospatial indexing, and Google Cloud infrastructure.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="group bg-white rounded-2xl p-6 border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col gap-5" style={`border-color: ${f.border}; background-color: ${f.bg};`}>

          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style={`background: ${f.accent}; opacity: 0.9;`}>
              {f.icon === 'ai' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M12 2a2 2 0 012 2v1a2 2 0 01-4 0V4a2 2 0 012-2z" fill="white" fill-opacity="0.3"/>
                  <path d="M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
                  <circle cx="12" cy="12" r="3" fill="white" fill-opacity="0.5"/>
                </svg>
              )}
              {f.icon === 'map' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" stroke-linejoin="round"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
                </svg>
              )}
              {f.icon === 'report' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              )}
              {f.icon === 'batch' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
              )}
              {f.icon === 'alert' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0" stroke-linecap="round"/>
                </svg>
              )}
              {f.icon === 'api' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
            </div>
            <span class="text-xs font-body font-semibold px-2.5 py-1 rounded-full" style={`color: ${f.accent}; background: ${f.bg}; border: 1px solid ${f.border};`}>
              {f.tag}
            </span>
          </div>

          <div>
            <h3 class="font-heading font-bold text-slate text-lg mb-2 leading-snug">{f.title}</h3>
            <p class="font-body text-slate/60 text-sm leading-relaxed">{f.description}</p>
          </div>

          <div class="flex gap-4 pt-3 border-t border-slate/8 mt-auto">
            {f.stats.map(s => (
              <div>
                <p class="font-heading font-bold text-lg" style={`color: ${f.accent};`}>{s.value}</p>
                <p class="font-body text-xs text-slate/50">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
