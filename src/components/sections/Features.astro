---
const features = [
  {
    icon: 'hotspot',
    tag: 'Auto Detection',
    title: 'AI-Powered Hotspot Identification',
    description: 'Computer vision algorithms automatically detect cells with abnormal temperature, active bypass diodes, and partial shading — no human review required.',
    stats: [
      { value: '99.4%', label: 'Detection accuracy' },
      { value: '<2s', label: 'Per panel' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'map',
    tag: 'Thermal Orthomosaic',
    title: 'Georeferenced Thermal Map',
    description: 'We generate high-resolution orthomosaics in real time combining RGB and infrared imagery. Every hotspot is georeferenced with exact GPS coordinates.',
    stats: [
      { value: '5cm/px', label: 'GSD resolution' },
      { value: 'GPS', label: 'Exact coordinates' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'report',
    tag: 'Smart Reports',
    title: 'AI-Generated PDF Reports',
    description: 'Every inspection automatically produces a professional report with anomaly classification, estimated production impact, and prioritized maintenance recommendations.',
    stats: [
      { value: '< 1h', label: 'Report delivery' },
      { value: 'PDF/CSV', label: 'Export formats' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
  {
    icon: 'drone',
    tag: 'Autonomous Flight',
    title: 'Intelligent Flight Planning',
    description: 'Plan complete inspection missions autonomously. The system optimizes flight paths for full farm coverage in the shortest time possible.',
    stats: [
      { value: '200ha', label: 'Per flight day' },
      { value: '100%', label: 'Coverage' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'alert',
    tag: 'Real-Time Alerts',
    title: 'Continuous Monitoring & Alerts',
    description: 'Automatic email and SMS alerts when critical anomalies are detected. Real-time dashboard with historical metric trends per string and inverter.',
    stats: [
      { value: '24/7', label: 'Active monitoring' },
      { value: '< 5min', label: 'Alert latency' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'integrate',
    tag: 'SCADA Integration',
    title: 'Connect to Your SCADA/EMS',
    description: 'Integrate SkyMetrics with your existing plant management systems via REST API or webhooks. Compatible with leading solar SCADA and monitoring platforms.',
    stats: [
      { value: 'REST', label: 'Documented API' },
      { value: '50+', label: 'Integrations' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
];
---

<section id="features" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-4 border" style="background: rgba(140,189,185,0.1); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
        Features
      </div>
      <h2 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-5">
        Everything you need to<br/>
        <span style="color: #8CBDB9;">maximize solar output</span>
      </h2>
      <p class="font-body text-slate/60 text-lg leading-relaxed">
        An all-in-one platform combining professional drones, high-precision thermographic sensors, and artificial intelligence to transform solar asset management.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="group bg-white rounded-2xl p-6 border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col gap-5" style={`border-color: ${f.border}; background-color: ${f.bg};`}>

          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center flex-shrink-0" style={`background: ${f.accent}; opacity: 0.9;`}>
              {f.icon === 'hotspot' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
                </svg>
              )}
              {f.icon === 'map' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" stroke-linejoin="round"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
                </svg>
              )}
              {f.icon === 'report' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                </svg>
              )}
              {f.icon === 'drone' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M12 12a3 3 0 100-6 3 3 0 000 6z"/><path d="M3 3l4 4M21 3l-4 4M3 21l4-4M21 21l-4-4" stroke-linecap="round"/><circle cx="12" cy="9" r="1" fill="white"/>
                </svg>
              )}
              {f.icon === 'alert' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0" stroke-linecap="round"/>
                </svg>
              )}
              {f.icon === 'integrate' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                </svg>
              )}
            </div>
            <span class="text-xs font-body font-semibold px-2.5 py-1 rounded-full" style={`color: ${f.accent}; background: ${f.bg}; border: 1px solid ${f.border};`}>
              {f.tag}
            </span>
          </div>

          <div>
            <h3 class="font-heading font-bold text-slate text-lg mb-2 leading-snug">{f.title}</h3>
            <p class="font-body text-slate/60 text-sm leading-relaxed">{f.description}</p>
          </div>

          <div class="flex gap-4 pt-3 border-t border-slate/8 mt-auto">
            {f.stats.map(s => (
              <div>
                <p class="font-heading font-bold text-lg" style={`color: ${f.accent};`}>{s.value}</p>
                <p class="font-body text-xs text-slate/50">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
