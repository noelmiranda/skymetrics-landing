---
const features = [
  {
    icon: 'ai',
    tag: 'Vision AI Engine',
    title: 'Radiometric Fault & Delta Detection',
    description: 'Analyzes raw thermal frames to extract pixel-level temperature readings and classify core anomalies — broken diodes, dead cells, soiling, and string disconnections — complete with calibrated ΔT severity scoring.',
    stats: [
      { value: '4', label: 'Fault Classes' },
      { value: 'ΔT', label: 'Exact Metrics' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'map',
    tag: 'PostGIS + Leaflet',
    title: 'Sub-Meter GPS Anomaly Mapping',
    description: 'Every anomaly is persisted with precise WGS-84 GPS coordinates in a PostGIS spatial database. Interactive Leaflet maps allow field O&M technicians to navigate directly to damaged modules via spatial bounding queries.',
    stats: [
      { value: 'WGS-84', label: 'Coordinate System' },
      { value: 'GiST', label: 'Spatial Index' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'report',
    tag: 'PDFKit Engine',
    title: 'Executive Inspection Reports',
    description: 'Generates publication-grade PDF reports instantly — featuring site anomaly summaries, module-level thermal metrics, temperature deltas (ΔT), severity rankings, and exact GPS coordinates for field intervention.',
    stats: [
      { value: 'PDF', label: 'Instant Export' },
      { value: 'ΔT 15°C', label: 'Threshold' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
  {
    icon: 'batch',
    tag: 'GCS Signed URLs',
    title: 'High-Throughput Batch Ingestion',
    description: 'Stream up to 100 thermal frames simultaneously or upload single ZIP archives directly from DJI/FLIR software via Google Cloud Storage signed URLs. Per-file failure isolation ensures seamless batch processing.',
    stats: [
      { value: '100', label: 'Frames/Batch' },
      { value: 'ZIP', label: 'Native Archive' },
    ],
    accent: '#8CBDB9',
    bg: 'rgba(140,189,185,0.06)',
    border: 'rgba(140,189,185,0.15)',
  },
  {
    icon: 'alert',
    tag: 'Real-Time Webhooks',
    title: 'Automated Critical Hotspot Alerts',
    description: 'When an anomaly breaches the industry-standard 15°C temperature delta threshold for crystalline silicon PV, the platform immediately triggers automated webhooks to alert your asset management system.',
    stats: [
      { value: 'Webhook', label: 'Instant Dispatch' },
      { value: 'IEC', label: '62446-3 Aligned' },
    ],
    accent: '#E09E50',
    bg: 'rgba(224,158,80,0.06)',
    border: 'rgba(224,158,80,0.15)',
  },
  {
    icon: 'api',
    tag: 'OpenAPI 3.0.3',
    title: 'Enterprise REST API & System Integration',
    description: 'Complete REST API with OpenAPI 3.0.3 specifications and interactive Swagger documentation. Seamlessly export structured anomaly payloads directly into your existing CMMS, asset management, or O&M platforms.',
    stats: [
      { value: 'OpenAPI', label: '3.0.3 Spec' },
      { value: '202', label: 'Async Ingestion' },
    ],
    accent: '#2D3E4E',
    bg: 'rgba(45,62,78,0.04)',
    border: 'rgba(45,62,78,0.1)',
  },
];
---

<section id="features" class="py-24 lg:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-4 border" style="background: rgba(140,189,185,0.1); color: #2D3E4E; border-color: rgba(140,189,185,0.3);">
        Platform Features
      </div>
      <h2 class="font-heading font-bold text-slate text-4xl lg:text-5xl leading-tight mb-5">
        Enterprise Architecture.<br/>
        <span style="color: #8CBDB9;">Production-Ready.</span>
      </h2>
      <p class="font-body text-slate/60 text-lg leading-relaxed">
        SkyMetrics Core is built for enterprise utility-scale solar — backed by rigorous automated testing, zero TypeScript errors, and an end-to-end cloud pipeline combining Vision AI, PostGIS spatial indexing, and Google Cloud infrastructure.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="group bg-white rounded-2xl p-6 border hover:shadow-xl transition-all duration-300 hover:-translate-y-1 flex flex-col gap-5" style={`border-color: ${f.border}; background-color: ${f.bg};`}>

          <div class="flex items-start justify-between">
            <div class="w-12 h-12 rounded-xl flex items-center justify-center shrink-0" style={`background: ${f.accent}; opacity: 0.9;`}>
              {f.icon === 'ai' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M12 2a2 2 0 012 2v1a2 2 0 01-4 0V4a2 2 0 012-2z" fill="white" fill-opacity="0.3"/>
                  <path d="M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round"/>
                  <circle cx="12" cy="12" r="3" fill="white" fill-opacity="0.5"/>
                </svg>
              )}
              {f.icon === 'map' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" stroke-linejoin="round"/><line x1="9" y1="3" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="21"/>
                </svg>
              )}
              {f.icon === 'report' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
              )}
              {f.icon === 'batch' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                </svg>
              )}
              {f.icon === 'alert' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0" stroke-linecap="round"/>
                </svg>
              )}
              {f.icon === 'api' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
                </svg>
              )}
            </div>
            <span class="text-xs font-body font-semibold px-2.5 py-1 rounded-full" style={`color: ${f.accent}; background: ${f.bg}; border: 1px solid ${f.border};`}>
              {f.tag}
            </span>
          </div>

          <div>
            <h3 class="font-heading font-bold text-slate text-lg mb-2 leading-snug">{f.title}</h3>
            <p class="font-body text-slate/60 text-sm leading-relaxed">{f.description}</p>
          </div>

          <div class="flex gap-4 pt-3 border-t border-slate/8 mt-auto">
            {f.stats.map(s => (
              <div>
                <p class="font-heading font-bold text-lg" style={`color: ${f.accent};`}>{s.value}</p>
                <p class="font-body text-xs text-slate/50">{s.label}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
