---
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---
<section id="contact" class="py-24 lg:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="relative rounded-3xl overflow-hidden" style="background: linear-gradient(135deg, #2D3E4E 0%, #1e2d3a 50%, #253545 100%);">

      <!-- Background decorations -->
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full" style="background: radial-gradient(circle, rgba(140,189,185,0.15) 0%, transparent 70%);"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 rounded-full" style="background: radial-gradient(circle, rgba(224,158,80,0.12) 0%, transparent 70%);"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px]">
          <svg width="100%" height="100%" viewBox="0 0 800 800" fill="none" opacity="0.04">
            <circle cx="400" cy="400" r="200" stroke="white" stroke-width="1"/>
            <circle cx="400" cy="400" r="300" stroke="white" stroke-width="1"/>
            <circle cx="400" cy="400" r="380" stroke="white" stroke-width="1"/>
          </svg>
        </div>
      </div>

      <div class="relative px-8 py-16 lg:px-16 lg:py-20">
        <div class="max-w-4xl mx-auto">

          <div class="text-center mb-12">
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-body font-semibold tracking-wide uppercase mb-6 border border-white/15" style="background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.7);">
              <span class="w-1.5 h-1.5 rounded-full bg-mint animate-pulse"></span>
              Request your inspection
            </div>
            <h2 class="font-heading font-bold text-white text-4xl lg:text-5xl leading-tight mb-5">
              Discover how much output<br/>
              <span style="color: #E09E50;">you're leaving on the table</span>
            </h2>
            <p class="font-body text-white/60 text-lg leading-relaxed max-w-2xl mx-auto">
              Most solar farms operate at 15–25% below optimal efficiency due to undetected faults.
              A thermographic inspection can recover all of that.
            </p>
          </div>

          <div class="grid lg:grid-cols-2 gap-8 items-start">

            <!-- Benefits list -->
            <div class="space-y-4">
              {[
                { icon: '⚡', title: 'Diagnosis in 48h', desc: 'Full report delivered in under two days from the inspection flight.' },
                { icon: '🎯', title: 'Tailored analysis', desc: 'Adapted to your farm\'s specifics: panel technology, inverter setup, and array configuration.' },
                { icon: '📊', title: 'Maintenance plan', desc: 'Receive a prioritized action plan with estimated ROI for each recommended intervention.' },
                { icon: '🔄', title: 'Ongoing follow-up', desc: 'Periodic monitoring to verify anomaly fixes and prevent new faults from developing.' },
              ].map(item => (
                <div class="flex items-start gap-4 p-4 rounded-xl border border-white/10" style="background: rgba(255,255,255,0.06);">
                  <span class="text-2xl flex-shrink-0">{item.icon}</span>
                  <div>
                    <h4 class="font-heading font-semibold text-white text-sm mb-1">{item.title}</h4>
                    <p class="font-body text-white/50 text-xs leading-relaxed">{item.desc}</p>
                  </div>
                </div>
              ))}
            </div>

            <!-- Contact form -->
            <div class="bg-white rounded-2xl p-7 shadow-2xl">
              <h3 class="font-heading font-bold text-slate text-xl mb-1">Request a Demo</h3>
              <p class="font-body text-slate/55 text-sm mb-6">No commitment · Response within 2 hours</p>

              <!-- Success state -->
              <div id="form-success" class="hidden flex-col items-center justify-center gap-4 py-10 text-center">
                <div class="w-16 h-16 rounded-full flex items-center justify-center" style="background: rgba(140,189,185,0.15); border: 2px solid #8CBDB9;">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#8CBDB9" stroke-width="2.5">
                    <path d="M22 11.08V12a10 10 0 11-5.93-9.14" stroke-linecap="round"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                </div>
                <div>
                  <p class="font-heading font-bold text-slate text-lg mb-1">Request received!</p>
                  <p class="font-body text-slate/55 text-sm">We'll get back to you within 2 hours.</p>
                </div>
              </div>

              <!-- Form -->
              <form id="demo-form" method="POST" action="https://api.web3forms.com/submit" class="space-y-4" novalidate>

                <!-- Web3Forms config -->
                <input type="hidden" name="access_key" value={accessKey} />
                <input type="hidden" name="subject" value="New Demo Request — SkyMetrics" />
                <input type="hidden" name="from_name" value="SkyMetrics Landing" />
                <input type="hidden" name="redirect" value="false" />
                <!-- Honeypot for bot protection -->
                <input type="text" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

                <div class="grid grid-cols-2 gap-3">
                  <div>
                    <label class="font-body text-xs font-semibold text-slate/60 uppercase tracking-wide block mb-1.5" for="first-name">First name</label>
                    <input id="first-name" name="name" type="text" placeholder="Your name" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate/15 font-body text-sm text-slate placeholder-slate/30 focus:outline-none focus:border-mint transition-all" />
                  </div>
                  <div>
                    <label class="font-body text-xs font-semibold text-slate/60 uppercase tracking-wide block mb-1.5" for="company">Company</label>
                    <input id="company" name="company" type="text" placeholder="Your company" class="w-full px-3.5 py-2.5 rounded-xl border border-slate/15 font-body text-sm text-slate placeholder-slate/30 focus:outline-none focus:border-mint transition-all" />
                  </div>
                </div>
                <div>
                  <label class="font-body text-xs font-semibold text-slate/60 uppercase tracking-wide block mb-1.5" for="email">Work email</label>
                  <input id="email" name="email" type="email" placeholder="you@company.com" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate/15 font-body text-sm text-slate placeholder-slate/30 focus:outline-none focus:border-mint transition-all" />
                </div>
                <div>
                  <label class="font-body text-xs font-semibold text-slate/60 uppercase tracking-wide block mb-1.5" for="capacity">Installed capacity (MW)</label>
                  <select id="capacity" name="capacity" class="w-full px-3.5 py-2.5 rounded-xl border border-slate/15 font-body text-sm text-slate focus:outline-none focus:border-mint transition-all bg-white">
                    <option value="">Select a range</option>
                    <option>1 – 10 MW</option>
                    <option>10 – 50 MW</option>
                    <option>50 – 200 MW</option>
                    <option>200 MW+</option>
                  </select>
                </div>
                <div>
                  <label class="font-body text-xs font-semibold text-slate/60 uppercase tracking-wide block mb-1.5" for="message">Message (optional)</label>
                  <textarea id="message" name="message" rows="3" placeholder="Tell us about your solar farm…" class="w-full px-3.5 py-2.5 rounded-xl border border-slate/15 font-body text-sm text-slate placeholder-slate/30 focus:outline-none focus:border-mint transition-all resize-none"></textarea>
                </div>

                <!-- Error banner -->
                <div id="form-error" class="hidden items-center gap-2.5 px-4 py-3 rounded-xl border border-red-200 bg-red-50">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2" class="shrink-0"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                  <p class="font-body text-xs text-red-600">Something went wrong. Please try again or email us directly.</p>
                </div>

                <button id="submit-btn" type="submit" class="w-full py-3.5 bg-solar text-white font-body font-bold text-base rounded-xl hover:bg-solar/90 transition-all shadow-lg hover:shadow-xl active:scale-95 flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed disabled:active:scale-100">
                  <span id="btn-label" class="flex items-center gap-2">
                    Request a Free Demo
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                  <span id="btn-loading" class="hidden items-center gap-2">
                    <svg class="animate-spin" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83" stroke-linecap="round"/></svg>
                    Sending…
                  </span>
                </button>
                <p class="text-center font-body text-xs text-slate/40">By submitting you accept our <a href="#" class="underline hover:text-slate/70 transition-colors">privacy policy</a></p>
              </form>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('demo-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const btnLabel = document.getElementById('btn-label');
  const btnLoading = document.getElementById('btn-loading');
  const successEl = document.getElementById('form-success');
  const errorEl = document.getElementById('form-error');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    submitBtn!.disabled = true;
    btnLabel?.classList.add('hidden');
    btnLoading?.classList.replace('hidden', 'flex');
    errorEl?.classList.replace('flex', 'hidden');
    errorEl?.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form!));

    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const json = await res.json();
      if (!json.success) throw new Error(json.message ?? 'Submission failed');

      form!.classList.add('hidden');
      successEl?.classList.replace('hidden', 'flex');
    } catch {
      errorEl?.classList.replace('hidden', 'flex');
      submitBtn!.disabled = false;
      btnLabel?.classList.remove('hidden');
      btnLoading?.classList.replace('flex', 'hidden');
    }
  });
</script>
