---
---
<section class="relative min-h-screen flex items-center pt-16 overflow-hidden" style="background: linear-gradient(160deg, #E8ECEB 0%, #dde4e2 60%, #d4deda 100%);">

  <!-- Decorative background gradients -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-20 right-0 w-96 h-96 rounded-full opacity-20" style="background: radial-gradient(circle, #8CBDB9 0%, transparent 70%);"></div>
    <div class="absolute bottom-20 left-0 w-80 h-80 rounded-full opacity-15" style="background: radial-gradient(circle, #E09E50 0%, transparent 70%);"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full opacity-5" style="background: radial-gradient(circle, #2D3E4E 0%, transparent 70%);"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Left: copy -->
      <div class="flex flex-col gap-6 lg:gap-8">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-mint/20 text-slate rounded-full text-xs font-body font-semibold tracking-wide uppercase w-fit border border-mint/30">
          <span class="w-1.5 h-1.5 rounded-full bg-mint animate-pulse"></span>
          Cutting-edge solar energy technology
        </div>

        <div class="space-y-4">
          <h1 class="font-heading font-bold text-slate leading-tight text-4xl sm:text-5xl lg:text-6xl">
            Drone
            <span class="relative">
              <span class="relative z-10" style="color: #E09E50;">Thermographic</span>
              <span class="absolute bottom-1 left-0 right-0 h-2 opacity-20 rounded-full" style="background: #E09E50;"></span>
            </span>
            <br/>Inspection &amp;
            <span style="color: #8CBDB9;"> AI </span>
            for Solar Farms
          </h1>
          <p class="font-body text-slate/65 text-lg leading-relaxed max-w-xl">
            Detect faults, hotspots, and anomalies in your photovoltaic panels in hours, not weeks.
            AI-automated reports that maximize the efficiency of your solar plant.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <a href="#contact" class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-solar text-white font-body font-bold text-base rounded-xl hover:bg-solar/90 transition-all shadow-lg hover:shadow-xl active:scale-95">
            Request a Free Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#how-it-works" class="inline-flex items-center justify-center gap-2 px-7 py-4 bg-white/70 text-slate font-body font-semibold text-base rounded-xl hover:bg-white transition-all border border-slate/15 backdrop-blur-sm hover:shadow-md active:scale-95">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" stroke="#2D3E4E" stroke-width="1.5"/>
              <path d="M10 8l6 4-6 4V8z" fill="#2D3E4E"/>
            </svg>
            Watch Demo Video
          </a>
        </div>

        <!-- Social proof -->
        <div class="flex items-center gap-6 pt-2">
          <div class="flex -space-x-2">
            {['#2D3E4E', '#8CBDB9', '#E09E50', '#4a6274'].map((c, i) => (
              <div class="w-8 h-8 rounded-full border-2 border-white flex items-center justify-center text-white text-xs font-bold" style={`background: ${c};`}>
                {['G', 'S', 'R', 'M'][i]}
              </div>
            ))}
          </div>
          <div>
            <p class="font-body text-sm font-semibold text-slate">50+ solar farms</p>
            <p class="font-body text-xs text-slate/55">trust SkyMetrics</p>
          </div>
          <div class="flex items-center gap-1">
            {[1,2,3,4,5].map(_ => (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="#E09E50"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            ))}
            <span class="font-body text-xs text-slate/55 ml-1">4.9 / 5</span>
          </div>
        </div>
      </div>

      <!-- Right: live dashboard mock card -->
      <div class="relative flex items-center justify-center">
        <div class="relative w-full max-w-lg">

          <!-- Decorative card shadows -->
          <div class="absolute -top-4 -left-4 w-full h-full rounded-3xl" style="background: linear-gradient(135deg, #8CBDB9 0%, #6ba8a4 100%); opacity: 0.3;"></div>
          <div class="absolute -bottom-4 -right-4 w-full h-full rounded-3xl" style="background: linear-gradient(135deg, #E09E50 0%, #c9813a 100%); opacity: 0.2;"></div>

          <div class="relative bg-white rounded-3xl shadow-2xl overflow-hidden border border-slate/10">

            <!-- Window chrome -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-slate/10" style="background: #2D3E4E;">
              <div class="flex items-center gap-2">
                <div class="flex gap-1.5">
                  <div class="w-3 h-3 rounded-full bg-red-400"></div>
                  <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div class="w-3 h-3 rounded-full bg-green-400"></div>
                </div>
                <span class="font-body text-xs text-white/60 ml-2">SkyMetrics Inspector — Panel Array A-7</span>
              </div>
              <div class="flex items-center gap-1.5">
                <div class="w-1.5 h-1.5 rounded-full bg-mint animate-pulse"></div>
                <span class="font-body text-xs text-white/60">Live</span>
              </div>
            </div>

            <div class="p-4 space-y-3">

              <!-- Thermal map SVG -->
              <div class="relative rounded-xl overflow-hidden" style="height: 200px; background: #1a1a2e;">
                <svg width="100%" height="100%" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice">
                  <defs>
                    <radialGradient id="hot1" cx="30%" cy="40%">
                      <stop offset="0%" stop-color="#FF4500" stop-opacity="0.9"/>
                      <stop offset="40%" stop-color="#FF8C00" stop-opacity="0.7"/>
                      <stop offset="100%" stop-color="#1a6b8a" stop-opacity="0"/>
                    </radialGradient>
                    <radialGradient id="hot2" cx="70%" cy="30%">
                      <stop offset="0%" stop-color="#FF6B35" stop-opacity="0.85"/>
                      <stop offset="40%" stop-color="#FFA500" stop-opacity="0.6"/>
                      <stop offset="100%" stop-color="#1a6b8a" stop-opacity="0"/>
                    </radialGradient>
                    <radialGradient id="hot3" cx="55%" cy="70%">
                      <stop offset="0%" stop-color="#FFD700" stop-opacity="0.8"/>
                      <stop offset="50%" stop-color="#FFA500" stop-opacity="0.4"/>
                      <stop offset="100%" stop-color="#1a6b8a" stop-opacity="0"/>
                    </radialGradient>
                    <linearGradient id="panelBg" x1="0%" y1="0%" x2="100%" y2="100%">
                      <stop offset="0%" stop-color="#0d4a6b"/>
                      <stop offset="100%" stop-color="#1a3a5c"/>
                    </linearGradient>
                  </defs>
                  <rect width="400" height="200" fill="url(#panelBg)"/>
                  <!-- Panel grid -->
                  {Array.from({length: 8}, (_, row) =>
                    Array.from({length: 12}, (_, col) => (
                      <rect x={col * 33 + 2} y={row * 25 + 2} width="30" height="22" rx="2" fill="#1e5a7a" stroke="#2d7a9a" stroke-width="0.5"/>
                    ))
                  )}
                  <!-- Heat overlays -->
                  <rect width="400" height="200" fill="url(#hot1)" style="mix-blend-mode: screen;"/>
                  <rect width="400" height="200" fill="url(#hot2)" style="mix-blend-mode: screen;"/>
                  <rect width="400" height="200" fill="url(#hot3)" style="mix-blend-mode: screen;"/>
                  <!-- Anomaly markers -->
                  <circle cx="120" cy="80" r="18" fill="none" stroke="#FF4500" stroke-width="2" stroke-dasharray="4 2"/>
                  <rect x="108" y="68" width="30" height="22" rx="2" fill="#FF4500" fill-opacity="0.3" stroke="#FF4500" stroke-width="1.5"/>
                  <text x="124" y="57" font-family="monospace" font-size="9" fill="#FF4500" text-anchor="middle">67.3°C ⚠</text>
                  <circle cx="280" cy="60" r="14" fill="none" stroke="#FF6B35" stroke-width="1.5" stroke-dasharray="3 2"/>
                  <rect x="270" y="50" width="22" height="17" rx="2" fill="#FF6B35" fill-opacity="0.25" stroke="#FF6B35" stroke-width="1"/>
                  <text x="281" y="40" font-family="monospace" font-size="9" fill="#FF6B35" text-anchor="middle">58.1°C</text>
                  <circle cx="220" cy="140" r="12" fill="none" stroke="#FFD700" stroke-width="1.5" stroke-dasharray="3 2"/>
                  <text x="221" y="167" font-family="monospace" font-size="8" fill="#FFD700" text-anchor="middle">51.4°C</text>
                  <!-- Temperature scale -->
                  <text x="8" y="192" font-family="monospace" font-size="7" fill="#8CBDB9">25°C</text>
                  <rect x="8" y="180" width="6" height="6" fill="#1a6b8a"/>
                  <rect x="16" y="180" width="6" height="6" fill="#FFA500"/>
                  <rect x="24" y="180" width="6" height="6" fill="#FF4500"/>
                  <text x="32" y="186" font-family="monospace" font-size="7" fill="#8CBDB9">→ 70°C</text>
                </svg>
                <div class="absolute top-3 right-3 bg-black/50 backdrop-blur-sm rounded-lg px-2.5 py-1.5 border border-white/10">
                  <div class="flex items-center gap-1.5">
                    <div class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse"></div>
                    <span class="font-body text-xs text-white font-semibold">3 Anomalies</span>
                  </div>
                </div>
              </div>

              <!-- Stats row -->
              <div class="grid grid-cols-3 gap-2">
                <div class="bg-background rounded-xl p-3 text-center">
                  <p class="font-heading font-bold text-slate text-xl">98.2%</p>
                  <p class="font-body text-xs text-slate/55 mt-0.5">Efficiency</p>
                </div>
                <div class="bg-red-50 rounded-xl p-3 text-center border border-red-100">
                  <p class="font-heading font-bold text-red-600 text-xl">3</p>
                  <p class="font-body text-xs text-slate/55 mt-0.5">Hotspots</p>
                </div>
                <div class="rounded-xl p-3 text-center" style="background-color: rgba(140,189,185,0.12);">
                  <p class="font-heading font-bold text-xl" style="color: #5a9994;">2.4h</p>
                  <p class="font-body text-xs text-slate/55 mt-0.5">Completed</p>
                </div>
              </div>

              <!-- Report ready notification -->
              <div class="flex items-center gap-2 px-3 py-2.5 rounded-xl" style="background: rgba(140,189,185,0.12); border: 1px solid rgba(140,189,185,0.3);">
                <div class="w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0" style="background: #8CBDB9;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-body text-xs font-semibold text-slate">PDF report generated</p>
                  <p class="font-body text-xs text-slate/50">AI anomaly analysis complete · 2 min ago</p>
                </div>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8CBDB9" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
